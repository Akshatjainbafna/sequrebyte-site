---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  ogType?: string;
}
const { title, description, path, noindex = false, schema = [], ogType = 'website' } = Astro.props;
// One canonical form everywhere: trailing slash, matching the sitemap.
const rawPath = path ?? Astro.url.pathname;
const canonicalPath = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
// Cookie-free analytics. Set PUBLIC_PLAUSIBLE_DOMAIN at build time to enable.
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const origin = new URL('/', Astro.site).href;
const graph = [
  {
    '@type': 'Organization',
    '@id': origin + '#org',
    name: 'SequreByte',
    url: origin,
    // TODO: add logo URL, legal name, sameAs profiles and contactPoint once supplied.
    description: 'Vulnerability management and compliance-readiness platform for ISO/IEC 27001, SOC 2 and the RBI Cyber Security Framework.',
  },
  {
    '@type': 'WebSite',
    '@id': origin + '#website',
    url: origin,
    name: 'SequreByte',
    publisher: { '@id': origin + '#org' },
    inLanguage: 'en',
  },
  ...schema,
];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SequreByte: vulnerability scanning that does its own homework" />
    <meta name="theme-color" content="#0a1633" />
    <meta property="og:site_name" content="SequreByte" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap"
    />

    <script is:inline src="/js/boot.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.js" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pages } from '../data/pages.js';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const origin = new URL('/', Astro.site).href;
const url = `${origin}${page.slug}/`;
// Same-group pages first, then the rest; never link to self.
const related = [...pages.filter((p) => p.slug !== page.slug && p.group === page.group), ...pages.filter((p) => p.group !== page.group)].slice(0, 4);

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    url,
    name: page.h1,
    description: page.description,
    isPartOf: { '@id': `${origin}#website` },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
      { '@type': 'ListItem', position: 2, name: page.nav, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: page.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base title={page.titleTag} description={page.description} schema={schema}>
  <Header />
  <main id="main">
    <article class="article wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">{page.nav}</li>
        </ol>
      </nav>

      <h1>{page.h1}</h1>
      <div class="a-intro">
        {page.intro.map((t) => <p>{t}</p>)}
      </div>

      {page.sections.map((s) => (
        <section class="a-sec">
          <h2>{s.h}</h2>
          {s.body.map((t) => <p>{t}</p>)}
          {s.list && (
            <ul class="a-list">
              {s.list.map(([k, v]) => <li><strong>{k}.</strong> {v}</li>)}
            </ul>
          )}
        </section>
      ))}

      <aside class="cta-band on-ink" aria-label="Book a demo">
        <div>
          <h2>See it on your own scope.</h2>
          <p>A working session with a person, set up around your apps, cloud and the frameworks you answer to.</p>
        </div>
        <a class="btn btn-primary" href="/#demo">Book a demo <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </aside>

      <section class="a-sec faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common questions</h2>
        {page.faqs.map(([q, a]) => (
          <div class="faq-item">
            <h3>{q}</h3>
            <p>{a}</p>
          </div>
        ))}
      </section>

      <section class="a-sec related" aria-labelledby="rel-h">
        <h2 id="rel-h">Keep reading</h2>
        <ul class="a-links">
          {related.map((r) => (
            <li><a href={`/${r.slug}/`}>{r.nav}</a><span>{r.blurb}</span></li>
          ))}
        </ul>
      </section>
    </article>
  </main>
  <Footer />
  <script is:inline src="/js/site.js" defer></script>
</Base>

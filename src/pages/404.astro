---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found | SequreByte" description="That page does not exist." path="/404" noindex>
  <Header />
  <main id="main" class="wrap lost">
    <p class="eyebrow">Control 404 &middot; status</p>
    <h1>This page was <span class="mark">not assessed</span>.</h1>
    <p class="lede">We looked, and there is nothing here. We will not mark it as green.</p>
    <p><a class="btn btn-primary" href="/">Back to the home page</a></p>
  </main>
  <Footer />
</Base>

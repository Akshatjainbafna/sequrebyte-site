---
import Logo from './Logo.astro';
import { pages } from '../data/pages.js';
---
<footer class="site-footer on-ink">
  <div class="wrap">
    <div>
      <Logo />
      <address>
        <!-- TODO: registered company name, address and contact email (supplied by the client) -->
        [Registered company name]<br />
        [Registered address]<br />
        <a href="mailto:hello@sequrebyte.example">hello@sequrebyte.example</a>
      </address>
    </div>
    <div>
      <nav class="foot-links" aria-label="Guides and roles">
        {pages.map((p) => <a href={`/${p.slug}/`}>{p.nav}</a>)}
      </nav>
      <nav class="foot-links foot-legal" aria-label="Legal">
        <a href="/privacy/">Privacy policy</a>
        <a href="/terms/">Terms</a>
      </nav>
    </div>
    <p class="foot-fine">&copy; {new Date().getFullYear()} SequreByte. Every number and screenshot on this site comes from the running product.</p>
  </div>
</footer>
